#!/bin/bash
# edit-guard - R2 by mechanism, not by discipline.
#
# Editing a recipe or class while a cooker is live makes bitbake reparse mid-run
# and abort with:
#   "When reparsing <recipe>:<task>, the basehash value changed from X to Y.
#    The metadata is not deterministic and this needs to be fixed."
# That has cost two whole build runs in this estate - once editing a recipe, once
# editing symoneural-pristine.bbclass - and both times the 400+ errors looked
# like real failures until the log was read.
#
# Call before ANY edit under meta-symoneural/:
#     meta-symoneural/tools/edit-guard || exit 1
#
# Exit 0 = no cooker, safe to edit. Exit 1 = a build is live, do not edit.
# Exit 2 = the check could not be performed (e.g. a sandboxed PID namespace) -
#          REFUSED; never read as "safe".
#
# 2026-09-15: this used to be an independent `pgrep -af "bin/bitbake "` scan.
# That scan missed bitbake-worker and bitbake-server processes and, inside a
# sandboxed PID namespace, found nothing at all and exited 0 - the exact
# silent-pass R16 forbids. It now defers to the one real implementation,
# tools/edit-guard -> tools/estate_processes.py guard, which scans /proc for
# bitbake, bitbake-server and bitbake-worker (including python-wrapped forms)
# and refuses (rc 2) when PID 1 is not the host init. One guard, one answer.
here=$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || exit 2
real="$here/../../tools/edit-guard"
if [ ! -x "$real" ]; then
    echo "edit-guard: REFUSING - real guard missing or not executable: $real" >&2
    exit 2
fi
exec "$real" "$@"
