#!/usr/bin/env python3
"""
symoneural-secrets — provision, verify and report every SyMoNeuRaL secret and config.

    sudo symoneural-secrets setup            # interactive: asks ONLY for the few external values
    sudo symoneural-secrets setup --non-interactive   # coder mode: generates internals, leaves externals UNSET
    symoneural-secrets status [--json]       # no sudo needed: reads manifest.json (names, never values)
    sudo symoneural-secrets verify           # exit 1 on placeholders / bad perms / bad owners
    sudo symoneural-secrets rotate KEY       # regenerate an internal token
    sudo symoneural-secrets show KEY         # print one value (root only, confirms first)
    sudo symoneural-secrets export-public DIR  # copy the public halves of keypairs (for meta-symoneural)

Design rules
  * Everything lives under /etc/symoneural. Secret files are root:root 0600, written
    atomically with umask 077. Nothing here is ever committed to git.
  * manifest.json (0644) records WHICH keys are set and a fingerprint of each value —
    never the value — so the coder can read it unprivileged and never has to ask.
  * Internal tokens are generated once and kept; they change only via `rotate`.
  * External values (Cloudflare tunnel token, Spotify app credentials, pool/wallet,
    TRON contract) are never invented. Unset means the dependent unit stays OFF.
  * Placeholders such as <paste token>, <id>, CHANGEME are treated as UNSET.
  * Idempotent: safe to run again at any time.
stdlib only.
"""
import argparse, getpass, hashlib, json, os, pwd, grp, re, secrets, shutil, subprocess, sys, tempfile, time

ROOT = "/etc/symoneural"
MANIFEST = os.path.join(ROOT, "manifest.json")
KEYDIR = os.path.join(ROOT, "licensing")
