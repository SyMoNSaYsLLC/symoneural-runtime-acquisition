# ---------------------------------------------------------------------------
def die(msg, code=1):
    print(f"symoneural-secrets: {msg}", file=sys.stderr); sys.exit(code)

def need_root():
    if os.geteuid() != 0:
        die("this command needs root — run with sudo")

def is_placeholder(v):
    return v is None or bool(PLACEHOLDER.match(v))

def fingerprint(v):
    return hashlib.sha256(v.encode()).hexdigest()[:12]

def read_env(path):
    vals = {}
    if not os.path.exists(path):
        return vals
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            v = v.strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                v = v[1:-1]
            vals[k.strip()] = v
    return vals

def write_env(path, entries, vals, extra):
    """entries: registry list; vals: current values; extra: unknown keys preserved."""
    lines = [f"# {os.path.basename(path)} — managed by symoneural-secrets. root:root 0600. Never commit.",
             f"# updated {time.strftime('%Y-%m-%d %H:%M:%S %z')}", ""]
    for key, kind, default, _, help_ in entries:
        v = vals.get(key)
        if is_placeholder(v):
            lines.append(f"# {help_}")
            lines.append(f"# {key}=   (UNSET — {kind})" if kind != "config" else f"{key}={default}")
        else:
            lines.append(f"{key}={v}")
    for k, v in sorted(extra.items()):
        lines.append(f"{k}={v}")
    atomic_write(path, "\n".join(lines) + "\n", 0o600)

def atomic_write(path, content, mode):
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    old = os.umask(0o077)
    try:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(tmp, mode); os.chown(tmp, 0, 0)
        os.replace(tmp, path)
    finally:
        os.umask(old)

def gen_token():
    return secrets.token_urlsafe(48)

def ensure_keypair(name):
    priv = os.path.join(KEYDIR, f"{name}.key"); pub = os.path.join(KEYDIR, f"{name}.pub")
    os.makedirs(KEYDIR, mode=0o700, exist_ok=True); os.chown(KEYDIR, 0, 0)
    created = False
    if not os.path.exists(priv):
        if shutil.which("openssl") is None:
            die("openssl not found; cannot generate ed25519 keypairs")
        old = os.umask(0o077)
        try:
            subprocess.run(["openssl", "genpkey", "-algorithm", "ed25519", "-out", priv], check=True)
            subprocess.run(["openssl", "pkey", "-in", priv, "-pubout", "-out", pub], check=True)
        finally:
            os.umask(old)
        created = True
    os.chmod(priv, 0o600); os.chown(priv, 0, 0)
    if os.path.exists(pub):
        os.chmod(pub, 0o644); os.chown(pub, 0, 0)
    return created, pub

def ensure_models_dir(path):
    try:
        uid = pwd.getpwnam(SERVICE_USER).pw_uid; gid = pwd.getpwnam(SERVICE_USER).pw_gid
    except KeyError:
        uid = gid = 0
    for d in [path] + [os.path.join(path, s) for s in MODELS_SUBDIRS]:
        os.makedirs(d, mode=0o755, exist_ok=True); os.chown(d, uid, gid)

def collect_state():
    """Build the manifest from files on disk. Root only (reads secrets)."""
    keys, files, unset_ext, suspects = {}, {}, [], []
    for fname, entries in REGISTRY.items():
        path = os.path.join(ROOT, fname)
        vals = read_env(path)
        if os.path.exists(path):
            st = os.stat(path)
            files[fname] = {"mode": oct(st.st_mode & 0o777), "owner": pwd.getpwuid(st.st_uid).pw_name}
        else:
            files[fname] = {"mode": None, "owner": None}
        for key, kind, default, rx, _ in entries:
            v = vals.get(key)
            if is_placeholder(v):
                status = "placeholder" if (v is not None and v.strip()) else "unset"
                if kind == "config":
                    status = "default"
                if kind == "external":
                    unset_ext.append(key)
                keys[key] = {"file": fname, "kind": kind, "status": status}
            else:
                status = "set"
                if rx and not re.match(rx, v):
                    status = "suspect"; suspects.append(key)
                keys[key] = {"file": fname, "kind": kind, "status": status, "fingerprint": fingerprint(v)}
    pairs = {}
    for name in KEYPAIRS:
        pub = os.path.join(KEYDIR, f"{name}.pub")
        if os.path.exists(pub):
            pairs[name] = {"public_key_path": pub,
                           "fingerprint": hashlib.sha256(open(pub, "rb").read()).hexdigest()[:16]}
        else:
            pairs[name] = {"public_key_path": None, "fingerprint": None}
    models_dir = read_env(os.path.join(ROOT, "api.env")).get("SYMON_MODELS_DIR", MODELS_DIR_DEFAULT)
    return {
        "schema": "symoneural-secrets/1",
        "updated": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "root": ROOT,
        "files": files,
        "keys": keys,
        "keypairs": pairs,
        "models_dir": {"path": models_dir, "exists": os.path.isdir(models_dir)},
        "unset_external": unset_ext,
        "suspect": suspects,
        "units_that_stay_off_until_set": {
            "TUNNEL_TOKEN": "named Cloudflare tunnel (quick tunnel still works)",
            "SPOTIFY_CLIENT_ID": "Remix", "SPOTIFY_CLIENT_SECRET": "Remix",
            "SYM_MINER_POOL": "real mining (benchmark still works)", "SYM_MINER_WALLET": "real mining",
            "SMTP_USER": "account request / approval / activation emails", "SMTP_PASS": "account emails",
            "SYM_GATEWAY_CONTRACT": "TRON licensing", "SYM_GATEWAY_BENEFICIARY": "TRON licensing",
        },
    }

def write_manifest(state):
    atomic_write(MANIFEST, json.dumps(state, indent=1, sort_keys=True) + "\n", 0o644)

# ---------------------------------------------------------------------------
def cmd_setup(a):
    need_root()
    os.makedirs(ROOT, mode=0o755, exist_ok=True); os.chown(ROOT, 0, 0); os.chmod(ROOT, 0o755)
    supplied = read_env(a.from_file) if a.from_file else {}
    if a.models_dir:
        supplied["SYMON_MODELS_DIR"] = a.models_dir
    only = {k.strip() for k in (a.only or "").split(",") if k.strip()}
    print(f"== symoneural-secrets setup ({'non-interactive' if a.non_interactive else 'interactive'}"
          f"{', only ' + ','.join(sorted(only)) if only else ''}) -> {ROOT}")
    for fname, entries in REGISTRY.items():
        path = os.path.join(ROOT, fname)
        current = read_env(path)
        known = {e[0] for e in entries}
        extra = {k: v for k, v in current.items() if k not in known}
        vals = {}
        for key, kind, default, rx, help_ in entries:
            v = supplied.get(key, current.get(key))
            targeted = (not only) or (key in only)
            if kind == "config":
                vals[key] = default if is_placeholder(v) else v
            elif kind == "internal":
                if is_placeholder(v) or (a.force_internal and targeted) or (only and key in only):
                    vals[key] = gen_token(); print(f"  generated {key}")
                else:
                    vals[key] = v
            else:  # external
                have = not is_placeholder(v)
                if have and not ((a.force and targeted) or (only and key in only)):
                    vals[key] = v; continue
                if not targeted:
                    vals[key] = v if have else None; continue
                if a.non_interactive:
                    vals[key] = v if have else None
                    if not have: print(f"  UNSET    {key}  (external; unit stays off)")
                    continue
                print(f"\n  {key}\n    {help_}")
                if have: print(f"    currently set (fingerprint {fingerprint(v)}); blank keeps it")
                entered = getpass.getpass("    value (blank = %s): " % ("keep current" if have else "leave unset")).strip()
                if is_placeholder(entered):
                    vals[key] = v if have else None; print("    kept" if have else "    left UNSET")
                else:
                    if rx and not re.match(rx, entered):
                        print("    warning: does not match the expected shape; kept anyway (status: suspect)")
                    vals[key] = entered; print(f"    set (fingerprint {fingerprint(entered)})")
        write_env(path, entries, vals, extra)
        print(f"  wrote {path}  root:root 0600")
    for name in KEYPAIRS:
        created, pub = ensure_keypair(name)
        print(f"  keypair {name}: {'GENERATED' if created else 'kept'}  public -> {pub}")
    models_dir = read_env(os.path.join(ROOT, "api.env")).get("SYMON_MODELS_DIR", MODELS_DIR_DEFAULT)
    ensure_models_dir(models_dir); print(f"  models dir {models_dir}  (owner {SERVICE_USER})")
    state = collect_state(); write_manifest(state)
    print(f"\n  manifest -> {MANIFEST} (0644, names and fingerprints only)")
    if state["unset_external"]:
        print("\n  Still UNSET (units depending on them stay off; nothing blocks):")
        for k in state["unset_external"]:
            print(f"    - {k}: {state['units_that_stay_off_until_set'].get(k, '')}")
    if state["suspect"]:
        print(f"\n  Suspect shape (check for a paste error): {', '.join(state['suspect'])}")
    print("\n  done.")

def cmd_status(a):
    if os.geteuid() == 0:
        state = collect_state(); write_manifest(state)
    else:
        if not os.path.exists(MANIFEST):
            die("no manifest yet — run: sudo symoneural-secrets setup")
        state = json.load(open(MANIFEST))
    if a.json:
        print(json.dumps(state, indent=1, sort_keys=True)); return
    print(f"symoneural secrets @ {state['root']}  (updated {state['updated']})")
    for fname in REGISTRY:
        f = state["files"].get(fname, {})
        print(f"\n  {fname:16} {f.get('mode') or 'MISSING':6} {f.get('owner') or ''}")
        for key, meta in state["keys"].items():
            if meta["file"] != fname: continue
            fp = meta.get("fingerprint", "")
            print(f"    {key:26} {meta['kind']:9} {meta['status']:12} {fp}")
    print("\n  keypairs")
    for n, p in state["keypairs"].items():
        print(f"    {n:26} {'present' if p['public_key_path'] else 'MISSING':12} {p['fingerprint'] or ''}")
    m = state["models_dir"]; print(f"\n  models dir {m['path']} {'exists' if m['exists'] else 'MISSING'}")
    if state["unset_external"]:
        print("\n  unset external: " + ", ".join(state["unset_external"]))

def cmd_verify(a):
    need_root()
    state = collect_state(); write_manifest(state); problems = []
    for fname, f in state["files"].items():
        if f["mode"] is None: problems.append(f"{fname}: missing (run setup)")
        elif f["mode"] != "0o600": problems.append(f"{fname}: mode {f['mode']} != 0o600")
        elif f["owner"] != "root": problems.append(f"{fname}: owner {f['owner']} != root")
    for key, meta in state["keys"].items():
        if meta["status"] == "placeholder": problems.append(f"{key}: placeholder text present — set it or leave blank")
        if meta["kind"] == "internal" and meta["status"] != "set": problems.append(f"{key}: internal token missing (run setup)")
    for n, p in state["keypairs"].items():
        if not p["public_key_path"]: problems.append(f"keypair {n}: missing (run setup)")
    if not state["models_dir"]["exists"]: problems.append(f"models dir {state['models_dir']['path']} missing")
    if problems:
        print("VERIFY: FAIL"); [print("  - " + p) for p in problems]; sys.exit(1)
    print("VERIFY: PASS  (unset externals are allowed: " + (", ".join(state["unset_external"]) or "none") + ")")

def cmd_rotate(a):
    need_root()
    for fname, entries in REGISTRY.items():
        for key, kind, default, rx, _ in entries:
            if key != a.key: continue
            if kind != "internal":
                die(f"{key} is {kind}; rotate it where it was issued, then run setup --force")
            path = os.path.join(ROOT, fname); vals = read_env(path)
            known = {e[0] for e in entries}; extra = {k: v for k, v in vals.items() if k not in known}
            vals[key] = gen_token(); write_env(path, entries, vals, extra)
            write_manifest(collect_state()); print(f"rotated {key} in {fname}; restart the services that read it"); return
    die(f"unknown key {a.key}")

def cmd_show(a):
    need_root()
    for fname, entries in REGISTRY.items():
        for key, *_ in entries:
            if key == a.key:
                v = read_env(os.path.join(ROOT, fname)).get(key)
                if is_placeholder(v): die(f"{key} is unset")
                if input(f"print {key} to this terminal? [y/N] ").strip().lower() != "y": sys.exit(0)
                print(v); return
    die(f"unknown key {a.key}")

def cmd_export_public(a):
    need_root(); os.makedirs(a.dir, exist_ok=True)
    for n in KEYPAIRS:
        src = os.path.join(KEYDIR, f"{n}.pub")
        if os.path.exists(src):
            dst = os.path.join(a.dir, f"{n}.pub"); shutil.copyfile(src, dst); os.chmod(dst, 0o644); print(f"  {dst}")

def main():
    p = argparse.ArgumentParser(prog="symoneural-secrets", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("setup"); s.add_argument("--non-interactive", action="store_true")
    s.add_argument("--from-file", help="KEY=VALUE file with external values (read once, then delete it)")
    s.add_argument("--models-dir"); s.add_argument("--force", action="store_true", help="re-prompt externals that are already set (blank keeps the current value)")
    s.add_argument("--only", help="comma-separated KEYS to (re)prompt or regenerate; everything else is left untouched, e.g. --only TUNNEL_TOKEN")
    s.add_argument("--force-internal", action="store_true", help="regenerate ALL internal tokens"); s.set_defaults(fn=cmd_setup)
    s = sub.add_parser("status"); s.add_argument("--json", action="store_true"); s.set_defaults(fn=cmd_status)
    s = sub.add_parser("verify"); s.set_defaults(fn=cmd_verify)
    s = sub.add_parser("rotate"); s.add_argument("key"); s.set_defaults(fn=cmd_rotate)
    s = sub.add_parser("show"); s.add_argument("key"); s.set_defaults(fn=cmd_show)
    s = sub.add_parser("export-public"); s.add_argument("dir"); s.set_defaults(fn=cmd_export_public)
    a = p.parse_args(); a.fn(a)

if __name__ == "__main__":
    main()
