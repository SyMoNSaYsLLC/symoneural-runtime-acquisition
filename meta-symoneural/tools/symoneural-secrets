PLACEHOLDER = re.compile(r"^\s*(<[^>]*>|CHANGEME|TODO|xxx+|\.\.\.)?\s*$", re.I)

# ---------------------------------------------------------------------------
# Registry: file -> [(KEY, kind, default, validator_regex_or_None, help)]
#   kind: external  = Garrett supplies (never generated)
#         internal  = generated once (url-safe token)
#         config    = plain default, editable
# ---------------------------------------------------------------------------
