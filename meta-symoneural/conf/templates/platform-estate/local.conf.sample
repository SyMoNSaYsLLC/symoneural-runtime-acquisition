# Symoneural-Platform :: ESTATE kernel target (build/devtool-master)
# Source of truth: meta-symoneural/conf/templates/platform-estate/local.conf.sample.
# Mirrors the other runtimes' build configuration (Symoneural-Common) plus the kernel
# selection this profile exists for. Nothing here changes a source pin.
MACHINE ??= "qemux86-64"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
CONF_VERSION = "2"
DL_DIR = "/home/google/SymonSaysLLC/Symoneural-Platform/downloads"
SSTATE_DIR = "/home/google/SymonSaysLLC/Symoneural-Platform/sstate-cache-master"
# Read-only reuse of sibling runtimes' sstate (toolchain, native tools); nothing is written there.
SSTATE_MIRRORS = "\
    file://.* file:///home/google/SymonSaysLLC/Symoneural-Common/sstate-cache-master/PATH \n \
    file://.* file:///home/google/SymonSaysLLC/Symoneural-Ravencalc/sstate-cache-master/PATH \n \
    "
BB_NUMBER_THREADS = "10"
PARALLEL_MAKE = "-j 12"

# KERNEL SELECTION (charter: linux-yocto 6.18.48). The pinned OE metadata carries linux-yocto
# 6.18.48 and 7.2.4; with no preference BitBake picks the HIGHEST version, 7.2.4 (Ravencalc's
# sstate holds such a build). This pin is the explicit resolution of that discrepancy in favour
# of the charter; the kernel actually built is read back from kernel-abiversion, never assumed.
PREFERRED_PROVIDER_virtual/kernel = "linux-yocto"
PREFERRED_VERSION_linux-yocto = "6.18%"
