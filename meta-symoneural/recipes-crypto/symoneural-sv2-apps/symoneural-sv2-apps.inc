# Shared by the two symoneural-sv2-apps* recipes: ONE pinned sv2-apps tree (stratum-mining),
# two Cargo workspaces with their own Cargo.lock - miner-apps (translator, jd-client) and
# pool-apps (pool, jd-server). Each recipe builds one workspace offline (--frozen) from the
# crate closure its <recipe>-crates.inc declares (generated by `bitbake -c update_crates`).
SUMMARY = "Stratum V2 applications (stratum-mining/sv2-apps) ${PV}"
HOMEPAGE = "https://github.com/stratum-mining/sv2-apps"
SECTION = "net"
LICENSE = "Apache-2.0 AND MIT"
LIC_FILES_CHKSUM = "file://LICENSE-APACHE;md5=86d3f3a95c324c9479bd8986968f4327 \
                    file://LICENSE-MIT;md5=abd40148cf3f5fc7a8052c45980fa081 \
                    file://LICENSE.md;md5=14ecc01e3adadf9652f355df43b4855f"
SYMON_TREE = "/home/google/SymonSaysLLC/Symoneural-Crypto/src/stratum/source/sv2-apps"
SRC_URI = "git://github.com/stratum-mining/sv2-apps;protocol=https;branch=release/v0.7.0"
SRCREV = "d7d556d1a3c7e1c26dfccd076b491a38c038a5e0"
PV = "0.7.0"
# bitcoin-capnp-types' build script runs the Cap'n Proto compiler (`capnp`, >= 0.5.2) through the
# capnpc crate: a BUILD tool, borrowed from meta-oe (capnproto 1.5.0 native); first launch of both
# workspaces failed on exactly "Failed to execute `capnp --version`".
DEPENDS += "capnproto-native"
# capnp's standard import paths are /usr/local/include and /usr/include (HOST paths) plus a
# compile-time CAPNP_INCLUDE_DIR that OE's native build leaves undefined, so the compiler cannot find
# its own /capnp/c++.capnp in the native sysroot - and would silently take a host copy if one were
# installed (second launch: "Import failed: /capnp/c++.capnp"). bitcoin-capnp-types' build.rs calls
# capnpc without an import path, so a recipe wrapper first on PATH makes every `capnp compile`
# hermetic: --no-standard-import and the native sysroot include dir as the only import path.
do_configure:append() {
    install -d ${WORKDIR}/capnp-wrapper
    cat > ${WORKDIR}/capnp-wrapper/capnp <<WRAP
#!/bin/sh
# symoneural: hermetic Cap'n Proto compiler for cargo build scripts (see symoneural-sv2-apps.inc)
if [ "\$1" = compile ]; then
    shift
    exec ${STAGING_BINDIR_NATIVE}/capnp compile --no-standard-import --import-path=${STAGING_INCDIR_NATIVE} "\$@"
fi
exec ${STAGING_BINDIR_NATIVE}/capnp "\$@"
WRAP
    chmod 0755 ${WORKDIR}/capnp-wrapper/capnp
}
do_compile:prepend() {
    export PATH="${WORKDIR}/capnp-wrapper:$PATH"
}
# upstream pins rust 1.88.0 in rust-toolchain.toml; the estate builds with oe-core's rust 1.98.1
# (cargo.bbclass ignores the toolchain file). Recorded; a compile failure on that gap is a decision.
