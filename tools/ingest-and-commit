#!/bin/bash
# ingest-and-commit <component> - S2 steps a-h for one tree: ingest (tools/ingest-tree),
# then ONE commit carrying the tree and the lock records. Never `git add`s the source
# path: the tree is already in the index from upstream's tree object, and add would
# re-run ignore rules over it. Push is separate and deliberate (pre-publish-audit first).
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
comp=$1
sp=$(python3 -c "import json,sys; print([c for c in json.load(open('acquisition/source-lock.json'))['components'] if c['component']==sys.argv[1]][0]['source_path'])" "$comp") || exit 1
out=$(python3 tools/ingest-tree ingest "$comp" 2>&1); rc=$?
printf '%s\n' "$out"
if [ $rc -ne 0 ]; then
    # a failed ingest may have left the index with the path removed (rm --cached) or
    # half read; put the index back to HEAD for that path so no later commit can
    # record the failure as a deletion. Lock files are not saved on failure.
    git reset -q -- "$sp" 2>/dev/null
    echo "INGEST FAILED rc=$rc - index restored to HEAD for $sp, nothing committed"
    exit $rc
fi
line=$(printf '%s\n' "$out" | tail -1)               # "<comp> · <sha12> · N files · STATUS"
excl=$(python3 -c "import json,sys; e=[c for c in json.load(open('acquisition/source-lock.json'))['components'] if c['component']==sys.argv[1]][0]; print(' · '.join('EXCLUDED '+x['path'] for x in e.get('excluded',[])))" "$comp")
# .git/index.lock is taken briefly by any concurrent index refresh (an editor's or
# the agent harness's `git status`); two of seven CLI ingests died on it with the
# tree already staged, so the next commit swept their files in. Retry, do not fail.
gitretry() {
    local n=0 out
    while :; do
        out=$(git "$@" 2>&1); rc=$?
        [ $rc -eq 0 ] && { [ -n "$out" ] && printf '%s\n' "$out"; return 0; }
        case "$out" in *index.lock*) n=$((n+1)); [ $n -le 10 ] && { sleep 1; continue; } ;; esac
        printf '%s\n' "$out"; return $rc
    done
}
gitretry add acquisition/source-lock.json acquisition/submodule-lock.json || exit 1
# Scope assertion (2026-09-15). `git commit` records the WHOLE index, so anything a
# previous step - or a person - left staged rides along under this message. Two
# CLI ingests once had exactly that happen (see the index.lock note above). Refuse
# unless every staged path is the ingested tree or one of the two lock files. The
# repository also holds a live API key one `git add .` away, so an unexpected
# staged path is treated as a hazard, not a convenience.
# quotePath=false: with the default, a staged path holding a non-ASCII byte is
# emitted C-quoted ("...\303\251.txt"), the leading quote defeats the ^<sp>/
# anchor, and an in-scope upstream fixture would be refused as a stray path.
# stderr is left on the terminal, not folded into the path list.
staged=$(git -c core.quotePath=false diff --cached --name-only); rc=$?
if [ $rc -ne 0 ]; then
    echo "COMMIT REFUSED - could not read the index (rc=$rc); nothing committed"
    exit 1
fi
stray=$(printf '%s\n' "$staged" | grep -vE "^(${sp//./\\.}/|acquisition/(source|submodule)-lock\.json$)"); grc=$?
if [ $grc -ge 2 ]; then
    echo "COMMIT REFUSED - scope check itself failed (grep rc=$grc); nothing committed"
    exit 1
fi
if [ -n "$stray" ]; then
    echo "COMMIT REFUSED - the index holds paths outside this ingest:"
    printf '%s\n' "$stray" | head -20 | sed 's/^/  /'
    echo "Unstage them (git restore --staged -- <path>) or commit them separately, then re-run."
    echo "The ingested tree and both lock files remain staged; nothing committed."
    exit 1
fi
msg="acquired source: $line"
[ -n "$excl" ] && msg="$msg · $excl"
gitretry commit -q -m "$msg

Ingested from the pin's tree object (tools/ingest-tree), not git add. Verifiable
from a clone: tools/ingest-tree verify $comp.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>"; rc=$?
[ $rc -eq 0 ] || { echo "COMMIT FAILED rc=$rc"; exit $rc; }
echo "COMMITTED $(git log -1 --format=%h) $line"
